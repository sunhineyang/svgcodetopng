# Site Configuration
# The base URL of your site (do NOT include trailing slash)
# Production: https://svgcodetopng.com
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://svgcodetopng.com

# DeepSeek API - AI SVG Assistant
# Get your API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase - Feedback Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Feedback Security
FEEDBACK_IP_SALT=a_random_secret_string
FEEDBACK_RATE_LIMIT_PER_HOUR=20
